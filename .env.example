# إعدادات بيئة العمل لموقع قصة العائلة | Qessa Family
# ========================================================

# 1. مفتاح YouTube Data API v3 (اختياري - يوجد نظام استخراج خادمي احتياطي تلقائي):
# للحصول على المفتاح:
# 1. اذهب إلى Google Cloud Console (https://console.cloud.google.com/)
# 2. أنشئ مشروعاً جديداً أو اختر مشروعاً حالياً.
# 3. فعّل خدمة "YouTube Data API v3" من مكتبة الـ APIs.
# 4. من قسم Credentials أنشئ API Key جديد.
# 5. ضع المفتاح هنا على الخادم فقط (ممنوع وضعه في الواجهة الأمامية VITE_).
YOUTUBE_API_KEY=

# 2. المنفذ الافتراضي لتشغيل الخادم (يتم ضبطه تلقائياً):
PORT=3000
